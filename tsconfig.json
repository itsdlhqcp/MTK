{
  "extends": "./node_modules/expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/index.jsx",
    "app/_layout.jsx", 
    "app/login.jsx", 
    "app/forgot.jsx", 
    "app/signup.jsx", 
    "app/welcome.jsx"
, "app/releaseCard.tsx"  ]
}
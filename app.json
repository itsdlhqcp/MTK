{
  "expo": {
    "name": "PloTwist",
    "slug": "MediaTalk",
    "description": "PloTwist for cinimophiles",
    "version": "1.0.0",
    "backgroundColor": "#000000",
    "orientation": "portrait",
    "icon": "./assets/images/testicon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mediatalk.plotwist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
        "android": {
        "compileSdkVersion": 35,
        "targetSdkVersion": 34,
        "buildToolsVersion": "35.0.0",
        "kotlinVersion": "1.7.20"
        }
        }
        ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/booking.png",
          "imageWidth": 1000,
          "enableFullScreenImage_legacy": true,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],

      "expo-font"
    ],
    "react-native-google-mobile-ads": {
      "androidAppId": "ca-app-pub-7806969239829181~9318981034"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "914fa909-af2f-4ae4-951d-30b3a259f8d3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/914fa909-af2f-4ae4-951d-30b3a259f8d3"
    }
  }
}
